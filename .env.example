# Copy to .env and fill in. Never commit or share this file.
PUID=568
PGID=568

# Plex (local address avoids the relay)
PLEX_URL=http://172.16.0.2:32400
PLEX_TOKEN=

# NostalgiaTV server
NTV_URL=http://172.16.0.2:19850
# Leave all three blank if no Configure login is set (open mode).
NTV_API_KEY=
NTV_USERNAME=
NTV_PASSWORD=
# Blank = active profile
NTV_PROFILE_ID=

# Discord bot (see README for setup)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to approve. Blank = anyone in the channel.
DISCORD_ALLOWED_USER_IDS=

SCAN_INTERVAL_MINUTES=15
LOOKBACK_DAYS=35
# Start with true: posts what it WOULD do without changing anything.
DRY_RUN=true
LOG_LEVEL=INFO
