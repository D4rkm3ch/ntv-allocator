# Paste into the stack's .env in Dockge and fill in. Never commit this file.
PUID=
PGID=
PLEX_TOKEN=
# Only if Configure has a login set:
NTV_USERNAME=
NTV_PASSWORD=
NTV_API_KEY=
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to approve; blank = anyone in the channel
DISCORD_ALLOWED_USER_IDS=

# Status page: a passphrase that allows changing channels from the Recent placements and Library pages.
# Leave blank to keep the pages read-only.
STATUS_EDIT_KEY=
